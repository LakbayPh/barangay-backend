PORT=3000
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=1d
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key

DATABASE_URL="postgresql://username:password@localhost:5432/barangay_backend?schema=public"

# Used only by npm run seed:admin.
FIRST_ADMIN_EMAIL=replace-with-admin-email
FIRST_ADMIN_PASSWORD=replace-with-strong-admin-password
